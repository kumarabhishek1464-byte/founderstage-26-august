# ─────────────────────────────────────────────────────────────────────────────────
# FounderStage — environment template.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# NEVER put a real credential in this file.
#
# The EXPO_PUBLIC_ prefix means the value is INLINED INTO THE JS BUNDLE at build
# time. Anyone with the app can read it. That is fine for the values below and is
# never fine for a service role key or any signing secret.
#
# Full reference, including which variables belong to CI rather than a developer
# machine: docs/ENVIRONMENT.md
# ─────────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────────

# Supabase project URL.
# Local (`supabase start`): http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public by design — it grants nothing beyond what Row Level
# Security allows, which is why RLS is mandatory on every user-accessible table.
# `supabase start` prints this.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# development | preview | production
# Selects the app identity (name, bundle id, scheme) in app.config.ts and the
# logger's verbosity.
EXPO_PUBLIC_ENV=development

# ── Optional ─────────────────────────────────────────────────────────────────────
#
# `KEY=` with nothing after it counts as unset, not as an empty value, so leaving
# any of these blank gets you the documented default.

# Sentry DSN. A DSN is a write-only ingest endpoint and is safe in the client.
# Leave blank locally: crash reporting falls back to the no-op adapter.
EXPO_PUBLIC_SENTRY_DSN=

# trace | debug | info | warn | error   (default: debug in dev, warn in production)
# No `silent` — see docs/ENVIRONMENT.md.
EXPO_PUBLIC_LOG_LEVEL=

# Set to `true` to mount the React Query devtools and the debug overlay.
# Off by default in every environment, development included.
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false

# ─────────────────────────────────────────────────────────────────────────────────
# SERVER / CI ONLY — never prefixed with EXPO_PUBLIC_, never read by the app.
#
# These live in EAS secrets and GitHub Actions secrets. They are listed here for
# discoverability only; a developer machine does not need them.
#
#   SUPABASE_SERVICE_ROLE_KEY   Bypasses RLS entirely. Edge Functions / migrations.
#   SUPABASE_DB_PASSWORD        Direct Postgres connection for migrations.
#   SENTRY_AUTH_TOKEN           Source map upload during an EAS build.
#   SENTRY_ORG                  Sentry organisation slug (read by app.config.ts at build).
#   SENTRY_PROJECT              Sentry project slug (read by app.config.ts at build).
#   EAS_PROJECT_ID              EAS project identifier.
#   EXPO_TOKEN                  CI authentication for EAS.
# ─────────────────────────────────────────────────────────────────────────────────
