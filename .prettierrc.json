{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": { "printWidth": 100, "proseWrap": "always" }
    },
    {
      "files": ["*.sql"],
      "options": { "printWidth": 100 }
    }
  ]
}
